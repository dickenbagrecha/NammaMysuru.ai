# NammaMysuru.ai - Root Environment Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Required for AI Chatbot and Voice streaming)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemini model name (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Database Configuration
# Local SQLite is configured by default (url: sqlite.db)
# For managed Postgres in production (e.g. Neon or Supabase):
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origin (Default is "*" if empty; set to your Vercel frontend URL in production)
# Example: https://nammamysuru-ai.vercel.app
CORS_ORIGIN=
