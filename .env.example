# NammaMysuru.ai - Root Environment Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Required for AI Chatbot and Voice streaming)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemini model name (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration (PostgreSQL / Neon)
# Runtime connection (pooled or standard connection):
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for Drizzle Kit migrations (unpooled):
# DATABASE_URL_DIRECT=postgresql://user:password@ep-host-direct.region.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Example for deployed Vercel frontend: https://nammamysuruai.vercel.app,http://localhost:5173
CORS_ORIGIN=https://nammamysuruai.vercel.app,http://localhost:5173
