# Backend Environment Variables (.env)

PORT=5000

# Google Gemini API Key (Required for AI Chatbot and Voice streaming)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemini model name (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS Allowed Origins for browser requests (Comma-separated list)
# Example: https://nammamysuru-ai.vercel.app,http://localhost:5173
CORS_ORIGIN=
