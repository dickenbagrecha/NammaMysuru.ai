# Backend Environment Variables (.env)

PORT=5000

# Google Gemini API Key (Required for AI Chatbot and Voice streaming)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemini model name (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# CORS Allowed Origin for browser requests
# Local default: http://localhost:5000 or http://localhost:5173
# Production example: https://nammamysuru-ai.vercel.app
CORS_ORIGIN=
